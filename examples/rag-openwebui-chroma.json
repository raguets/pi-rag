{
  "version": 1,
  "embeddingProviders": {
    "openwebui-ollama": {
      "type": "ollama",
      "baseUrl": "http://localhost:11434",
      "model": "qwen3-embedding:0.6b",
      "expectedDimensions": 1024,
      "queryTemplate": "{{query}}"
    }
  },
  "vectorStores": {
    "openwebui-chroma": {
      "type": "chroma",
      "url": "http://localhost:8000",
      "tenant": "default_tenant",
      "database": "default_database"
    }
  },
  "knowledgeBases": {
    "openwebui-documents": {
      "description": "Knowledge base indexed by Open WebUI in the shared ChromaDB server",
      "vectorStore": "openwebui-chroma",
      "embeddingProvider": "openwebui-ollama",
      "collection": "REPLACE_WITH_OPENWEBUI_KNOWLEDGE_BASE_ID",
      "dimensions": 1024,
      "distance": "cosine",
      "payload": {
        "content": "content",
        "title": "name",
        "source": "file_id",
        "metadata": ["file_id", "name"]
      },
      "filterableFields": ["file_id", "name"],
      "search": {
        "topK": 8,
        "maxTopK": 30,
        "scoreThreshold": 0.4,
        "maxCharsPerChunk": 4000,
        "maxTotalChars": 20000
      }
    }
  }
}
