{
  "name": "@raguets/pi-rag",
  "version": "1.0.0",
  "description": "RAG extension for Pi with Qdrant, pgvector, ChromaDB and OpenAI-compatible embedding providers.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/",
    "scripts/",
    "examples/",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "rag",
    "retrieval-augmented-generation",
    "qdrant",
    "pgvector",
    "chromadb",
    "embeddings",
    "vector-database",
    "knowledge-base"
  ],
  "author": {
    "name": "raguets"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raguets/pi-rag.git"
  },
  "homepage": "https://github.com/raguets/pi-rag#readme",
  "bugs": {
    "url": "https://github.com/raguets/pi-rag/issues"
  },
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepack": "npm run check && npm test && npm run build"
  },
  "dependencies": {
    "pg": "^8.16.3",
    "zod": "^4.1.5"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.3.0",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "typebox": "^1.3.27",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
