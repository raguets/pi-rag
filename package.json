{
  "name": "pi-rag",
  "version": "0.1.0",
  "description": "Read-only RAG extension for Pi with Qdrant ingestion tooling",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist", "scripts", "examples", "README.md"],
  "keywords": ["pi-package", "rag", "qdrant"],
  "pi": { "extensions": ["./dist/index.js"] },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": { "@sinclair/typebox": "^0.34.41", "zod": "^4.1.5" },
  "peerDependencies": { "@mariozechner/pi-coding-agent": "*" },
  "devDependencies": { "@mariozechner/pi-coding-agent": "npm:@earendil-works/pi-coding-agent@^0.84.2", "@types/node": "^24.3.0", "typescript": "^5.9.2", "vitest": "^3.2.4" },
  "engines": { "node": ">=20" },
  "license": "MIT"
}
